  priority: 10
  dialogues:
  - dialogue: Nesrin...
    speaker: {fileID: 11400000, guid: 1fa1cdefcfaf4994db725a2bbcdf6ad8, type: 2}
  - dialogue: Taro aurait fait mieux que toi, tu t'en rends compte ?
    speaker: {fileID: 11400000, guid: 42c7a74fcdbb22b4494ecbdeb1d00265, type: 2}
  - dialogue: Je sais...
    speaker: {fileID: 11400000, guid: 1fa1cdefcfaf4994db725a2bbcdf6ad8, type: 2}
  - dialogue: Cesse de te morfondre, et continue. Nous avons besoin d'un nouveau
      chef, pas d'une loque humaine.
    speaker: {fileID: 11400000, guid: 42c7a74fcdbb22b4494ecbdeb1d00265, type: 2}
  dialogueEvent:
    m_PersistentCalls:
      m_Calls: []
